{
  "schemaVersion": "4.0.0",
  "artifactKind": "four-platform-equivalence-contract",
  "description": "四个平台只读审计的静态等价合同，不记录候选运行状态。",
  "platformSet": ["claude-code", "codex", "kimi-code", "workbuddy"],
  "modeSet": ["static", "runtime", "combined"],
  "equivalenceChecks": [
    {"check": "candidate_identical", "required": true, "evidenceRequirement": "绑定同一候选摘要"},
    {"check": "core_skill_identical", "required": true, "evidenceRequirement": "安装入口与核心审计资源逐字节同源"},
    {"check": "mode_identical", "required": true, "evidenceRequirement": "审计模式一致"},
    {"check": "frozen_input_identical", "required": true, "evidenceRequirement": "冻结输入摘要一致"},
    {"check": "audit_result_schema_valid", "required": true, "evidenceRequirement": "机器结果通过同一 audit-result Schema"},
    {"check": "report_present", "required": true, "evidenceRequirement": "每个平台均生成人读报告"},
    {"check": "target_unchanged", "required": true, "evidenceRequirement": "审计前后目标摘要一致"},
    {"check": "installation_isolated", "required": true, "evidenceRequirement": "只从本轮隔离安装发现 SFA"}
  ],
  "allowedDifferencesWhitelist": [
    "平台 CLI 版本和原生事件流",
    "隔离安装路径",
    "在相同输入与规则下形成的不同语义发现和建议"
  ],
  "adjudicationPolicy": {
    "sameCandidateRequired": true,
    "allChecksRequired": true,
    "targetExecutionForbidden": true,
    "publicPackageSelfClaimForbidden": true,
    "externalSemanticReviewRequired": true,
    "historyMigrationForbidden": true
  }
}
