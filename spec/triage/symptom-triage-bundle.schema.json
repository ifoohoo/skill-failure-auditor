{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "symptom-triage-bundle.schema.json",
  "title": "Cross-Repository Symptom Triage Report",
  "description": "跨仓故障归因只读诊断报告（US-074）的机器可读契约，记录主责仓库、次要关联组件、环境与依赖快照及下一步只读排查建议。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "read_only",
    "primary_owner",
    "secondary_components",
    "input_summary",
    "environment",
    "recommended_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "诊断报告契约版本号，固定为 1.0。"
    },
    "kind": {
      "const": "skill-family.symptom-triage-report",
      "description": "跨技能族症状归因报告的固定类型标识。"
    },
    "read_only": {
      "const": true,
      "description": "声明本次诊断全流程仅做只读取证，未修改受检工作区或运行受检技能。"
    },
    "primary_owner": {
      "type": "object",
      "description": "按因果根因优先级裁决出的主责仓库或配置层。",
      "additionalProperties": false,
      "required": ["repo", "layer", "confidence", "matched_codes", "matched_fingerprints", "summary_zh"],
      "properties": {
        "repo": {
          "type": "string",
          "enum": [
            "skill-family-foundation",
            "artifact-graph",
            "agent-method-registry",
            "humanize-rewrite",
            "skill-family-test",
            "skill-family-studio",
            "skill-family-hub",
            "release-skill",
            "skill-failure-auditor",
            "host-configuration",
            "domain-skill-plugin",
            "business-skill"
          ],
          "description": "主责仓库标识或宿主/业务技能归属层。"
        },
        "layer": {
          "type": "string",
          "description": "主责组件在技能族体系中的职责层中文名称。"
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "归因置信度：命中标准错误码前缀为 high，命中专属特征指纹为 medium，信号不足回退为 low。"
        },
        "matched_codes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "在输入症状或日志中命中的标准错误码列表。"
        },
        "matched_fingerprints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "在输入症状或日志中命中的特征指纹列表。"
        },
        "summary_zh": {
          "type": "string",
          "minLength": 4,
          "description": "一句话中文根因归属说明。"
        }
      }
    },
    "secondary_components": {
      "type": "array",
      "description": "同次报错栈中出现的次要关联仓库或传播包装层。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "layer", "role", "matched_codes", "matched_fingerprints", "reason_zh"],
        "properties": {
          "repo": { "type": "string" },
          "layer": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["caller_or_propagation", "co_occurring_gate", "context_reference"],
            "description": "该组件在本次报错中的关联角色。"
          },
          "matched_codes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "matched_fingerprints": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reason_zh": {
            "type": "string",
            "minLength": 4,
            "description": "说明为何该组件不是直接根因或如何参与错误传播。"
          }
        }
      }
    },
    "input_summary": {
      "type": "object",
      "description": "只读采集的故障描述与日志摘要元数据。",
      "additionalProperties": false,
      "required": ["sources", "total_chars", "symptom_sha256", "structured_error_codes"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "string" } },
        "total_chars": { "type": "integer", "minimum": 0 },
        "symptom_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "structured_error_codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "environment": {
      "type": "object",
      "description": "只读采集的宿主环境、运行时版本、工作区 Git SHA 与内部依赖实际解析版本。",
      "additionalProperties": true
    },
    "recommended_actions": {
      "type": "array",
      "minItems": 1,
      "description": "针对主责仓库与关联组件的下一步只读排查命令与处理建议。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "target_repo", "command_or_check", "purpose_zh"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "target_repo": { "type": "string" },
          "command_or_check": { "type": "string", "minLength": 2 },
          "purpose_zh": { "type": "string", "minLength": 4 }
        }
      }
    },
    "bundle_files": {
      "type": "array",
      "description": "指定 --output-bundle 时写入诊断包目录的文件及 SHA-256 摘要。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "versionUpgradeHint": {
      "type": "array",
      "description": "当目标工作区锁定底座版本低于关键修复版本且症状命中对应宿主、清单或对齐信号时生成的精准版本落后因果提醒。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "locked_version", "recommended_version", "matched_signals", "reason_zh"],
        "properties": {
          "package": { "type": "string" },
          "locked_version": { "type": "string" },
          "declared_spec": { "type": ["string", "null"] },
          "resolved_version": { "type": ["string", "null"] },
          "version_source": { "type": "string", "enum": ["declared", "resolved"] },
          "recommended_version": { "type": "string" },
          "matched_signals": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "reason_zh": { "type": "string", "minLength": 4 }
        }
      }
    }
  }
}
