{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-failure-auditor:orchestration:task-package:2.1.0",
  "title": "Unified Isolated Audit Task Package",
  "description": "平台无关的任务包合同。由 r11 claude-task-package.schema.json 泛化：平台字段进入任务包，原生角色/代理类型映射由 platform-adapter-mapping.json 承担，任务包只承载语义角色。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "platform",
    "mode",
    "target",
    "evidence_type",
    "output_root",
    "allowed_write_paths",
    "source_manifest",
    "evidence_index",
    "registry",
    "selection",
    "prompt_manifest",
    "prompts",
    "expected_roles",
    "acceptance_criteria",
    "package_digest"
  ],
  "properties": {
    "schema_version": { "const": "2.1" },
    "task_id": { "type": "string", "pattern": "^AUDIT-[A-Z0-9][A-Z0-9._-]+$" },
    "platform": { "type": "string", "enum": ["claude-code", "codex", "kimi-code", "workbuddy"] },
    "mode": { "type": "string", "enum": ["static", "runtime", "combined"] },
    "target": { "$ref": "#/$defs/subject_binding" },
    "evidence_type": { "type": "string", "minLength": 1 },
    "output_root": { "type": "string", "pattern": "^/" },
    "allowed_write_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
    "source_manifest": { "$ref": "#/$defs/binding" },
    "evidence_index": { "$ref": "#/$defs/binding" },
    "registry": { "$ref": "#/$defs/binding" },
    "selection": { "$ref": "#/$defs/binding" },
    "prompt_manifest": { "$ref": "#/$defs/binding" },
    "prompts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/prompt_binding" }
    },
    "expected_roles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/role" }
    },
    "acceptance_criteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "package_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "description": "模式-角色集合守恒：static 与 runtime 各 5 角色，combined 全 6 角色；expected_roles 必须与 prompts 角色集合精确相等。",
      "if": { "properties": { "mode": { "const": "static" } }, "required": ["mode"] },
      "then": { "properties": { "expected_roles": { "type": "array", "minItems": 5, "maxItems": 5, "not": { "type": "array", "contains": { "const": "runtime-evidence" } } } } }
    },
    {
      "if": { "properties": { "mode": { "const": "runtime" } }, "required": ["mode"] },
      "then": { "properties": { "expected_roles": { "type": "array", "minItems": 5, "maxItems": 5, "not": { "type": "array", "contains": { "const": "static-audit" } } } } }
    },
    {
      "if": { "properties": { "mode": { "const": "combined" } }, "required": ["mode"] },
      "then": { "properties": { "expected_roles": { "type": "array", "minItems": 6, "maxItems": 6 } } }
    }
  ],
  "$defs": {
    "role": {
      "type": "string",
      "enum": ["scope-routing", "static-audit", "runtime-evidence", "evaluation-integrity", "adversarial-challenge", "result-synthesis"]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "subject_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "tree_algorithm", "tree_sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "tree_algorithm": { "const": "tree-sha256-v1" },
        "tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "prompt_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
