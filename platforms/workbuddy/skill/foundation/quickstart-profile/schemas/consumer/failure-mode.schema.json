{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "failure-mode.schema.json",
  "title": "Failure Mode Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "name_zh",
    "legacy_definition",
    "category",
    "severity",
    "priority",
    "modes",
    "applies_when",
    "falsifiers",
    "required_evidence",
    "observable_signals",
    "conflicts_with",
    "depends_on",
    "mutation_operators",
    "core_redline",
    "guidance_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(FM-(0[1-9]|1[0-9]|2[0-8])|SYN-[0-9]{4})$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name_zh": {
      "type": "string",
      "minLength": 2
    },
    "legacy_definition": {
      "type": "string",
      "minLength": 4
    },
    "category": {
      "type": "string",
      "enum": [
        "goal_alignment",
        "self_evaluation",
        "context_reliability",
        "instruction_design",
        "role_collaboration",
        "runtime_governance",
        "evidence_integrity",
        "meta_governance"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "static",
          "runtime",
          "combined"
        ]
      }
    },
    "applies_when": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_types",
        "evidence_types",
        "conditions"
      ],
      "properties": {
        "target_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "falsifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "observable_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "conflicts_with": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(FM-(0[1-9]|1[0-9]|2[0-8])|SYN-[0-9]{4})$"
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(FM-(0[1-9]|1[0-9]|2[0-8])|SYN-[0-9]{4})$"
      }
    },
    "mutation_operators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "expected_detection"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MUT-(FM-[0-9]{2}|SYN-[0-9]{4})-[0-9]{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 4
          },
          "expected_detection": {
            "type": "string",
            "enum": [
              "must_detect",
              "should_detect"
            ]
          }
        }
      }
    },
    "core_redline": {
      "type": "boolean"
    },
    "guidance_ref": {
      "type": "string",
      "pattern": "^references/[a-z0-9-]+\\.md$"
    }
  }
}
