{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-failure-auditor:orchestration:result:2.1.0",
  "title": "Unified Role Result v2.1",
  "description": "单个语义职责的归一化结果外壳（L3）。由 v2.0 升级：native_receipt 扩展为完整平台回执绑定，新增 artifact 职责成果绑定，outputs 对 COMPLETED 必填且 minItems>=1。主上下文不得制造本结构冒充子智能体输出。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "platform",
    "role",
    "status",
    "attempt",
    "native_receipt",
    "outputs",
    "artifact",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^AUDIT-[A-Z0-9][A-Z0-9._-]+$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "kimi-code",
        "workbuddy"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "scope-routing",
        "static-audit",
        "runtime-evidence",
        "evaluation-integrity",
        "adversarial-challenge",
        "result-synthesis"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "FAILED",
        "TIMEOUT",
        "SCHEMA_INVALID",
        "RECEIPT_MISMATCH"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "native_receipt": {
      "type": [
        "object",
        "null"
      ],
      "description": "L1 平台原生回执绑定。由适配器从平台原始事件归一化，证明真实派发发生过。COMPLETED 状态必须非 null。",
      "additionalProperties": false,
      "required": [
        "platform",
        "task_id",
        "role",
        "kind",
        "native_agent_type",
        "invocation_id",
        "raw_record",
        "completion"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex",
            "kimi-code",
            "workbuddy"
          ]
        },
        "task_id": {
          "type": "string",
          "pattern": "^AUDIT-[A-Z0-9][A-Z0-9._-]+$"
        },
        "role": {
          "type": "string",
          "enum": [
            "scope-routing",
            "static-audit",
            "runtime-evidence",
            "evaluation-integrity",
            "adversarial-challenge",
            "result-synthesis"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "claude-trace",
            "codex-collaboration-receipt",
            "kimi-stream-json",
            "workbuddy-stream-json"
          ]
        },
        "native_agent_type": {
          "type": "string",
          "minLength": 1
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_record": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "exit_status",
                "completion_event"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            }
          }
        }
      }
    },
    "outputs": {
      "type": [
        "array",
        "null"
      ],
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "artifact": {
      "type": [
        "object",
        "null"
      ],
      "description": "L2 职责成果绑定。指向子智能体产出的 role-artifact JSON 文件，引擎回读重算摘要。COMPLETED 状态必须非 null。",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "description": "COMPLETED 结果必须绑定至少一个输出文件、回执和制品",
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "type": "array",
            "minItems": 1
          },
          "native_receipt": {
            "type": "object"
          },
          "artifact": {
            "type": "object"
          }
        }
      }
    }
  ]
}
