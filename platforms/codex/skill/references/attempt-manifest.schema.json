{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attempt-manifest.schema.json",
  "title": "Technical Attempt Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "candidate_sha256",
    "criteria_commitment_sha256",
    "allowed_write_set",
    "created_at",
    "created_by",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "attempt_id": {"type": "string", "pattern": "^ATTEMPT-[A-Z0-9][A-Z0-9._-]+$"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "criteria_commitment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed_write_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

